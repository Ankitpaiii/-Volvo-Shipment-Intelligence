ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///./volvo_shipments.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
GAP_CHECK_INTERVAL_SECONDS=30
GPS_SIMULATION_INTERVAL_SECONDS=15

# Authentication & RBAC (Optional / Production)
# Set to 'true' for local development without credentials
AUTH_DISABLED=true
# Comma-separated key:role pairs (roles: admin, operator, viewer)
API_KEYS=dev-key-1:operator,admin-key-1:admin

